DEMO_PORT=443
API_PORT=8443

# Left empty, the server generates these at startup and every registration is lost on restart.
# Fill them in (openssl rand -hex 32) for a demo whose state survives `make down && make up`.
SERVER_KEY_SEED_HEX=
OPRF_SEED_HEX=
OPRF_MASTER_KEY_HEX=
JWT_SECRET_HEX=

# Set to false to make the server refuse to start when the four keys above are empty.
ALLOW_EPHEMERAL_KEYS=true
